# PostgreSQL connection string
# Local:    postgresql://postgres:postgres@localhost:5432/erp_crm?schema=public
# Supabase/Neon/Render: copy the connection string they give you
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_crm?schema=public"

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-this-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

PORT=4000
NODE_ENV=development

# Comma-free single origin of the deployed/local frontend, or * for dev
CORS_ORIGIN="http://localhost:5173"
