// Prisma schema for Fundsroom Mini Operations ERP case study

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATIONS
  SALES
}

enum WOStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum TransferStatus {
  REQUESTED
  DISPATCHED
  RECEIVED
}

enum OrderStatus {
  PENDING
  RESERVED
  CANCELLED
  FULFILLED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  createdAt    DateTime  @default(now())

  workOrdersAssigned WorkOrder[]     @relation("WorkOrderAssignedTo")
  customerOrders     CustomerOrder[]

  @@map("users")
}

model Location {
  id   String @id @default(uuid())
  name String @unique

  inventoryItems InventoryItem[]
  workOrders     WorkOrder[]
  transfersOut   StockTransfer[] @relation("TransferSource")
  transfersIn    StockTransfer[] @relation("TransferDest")
  customerOrders CustomerOrder[]
  users          User[]

  @@map("locations")
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  category    String
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  batch       String
  physicalQty Int      @default(0)
  reservedQty Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, locationId, batch])
  @@index([locationId])
  @@map("inventory_items")
}

model WorkOrder {
  id             String   @id @default(uuid())
  locationId     String
  location       Location @relation(fields: [locationId], references: [id])
  itemName       String
  requiredQty    Int
  assignedUserId String
  assignedUser   User     @relation("WorkOrderAssignedTo", fields: [assignedUserId], references: [id])
  status         WOStatus @default(ASSIGNED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([status])
  @@map("work_orders")
}

model StockTransfer {
  id           String         @id @default(uuid())
  sourceLocId  String
  sourceLoc    Location       @relation("TransferSource", fields: [sourceLocId], references: [id])
  destLocId    String
  destLoc      Location       @relation("TransferDest", fields: [destLocId], references: [id])
  itemName     String
  quantity     Int
  status       TransferStatus @default(REQUESTED)
  dispatchedAt DateTime?
  receivedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceLocId])
  @@index([destLocId])
  @@index([status])
  @@map("stock_transfers")
}

model CustomerOrder {
  id           String      @id @default(uuid())
  customerName String
  itemName     String
  locationId   String
  location     Location    @relation(fields: [locationId], references: [id])
  quantity     Int
  status       OrderStatus @default(PENDING)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([status])
  @@map("customer_orders")
}
